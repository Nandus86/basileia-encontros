# Modo de teste: contas e perfis que "jogam" sozinhos (com o Mongo configurado, os CPFs reais entram junto)
ENCONTROS_MODO_DEMO=true

# Produção
# ENCONTROS_DATABASE_URL=postgresql+asyncpg://usuario:senha@basile-postgres:5432/basile
# ENCONTROS_MONGO_URI=mongodb://basile:...@.../?authSource=admin   (o usuário só de leitura do Motor de Cuidado)
# ENCONTROS_MONGO_DB=dexos_basileia
# ENCONTROS_IGREJAS=id1,id2            ("*" = todas)
ENCONTROS_JWT_SECRET=troque-por-um-segredo-longo
# Painel /lider (aprovar o conteúdo da IA). No modo de teste, sem chave, vale "lider-teste"
# ENCONTROS_CHAVE_LIDER=
ENCONTROS_ORIGENS=http://localhost:3020
ENCONTROS_PORTA=8020

# Quem pode usar (estados civis do cadastro, separados por vírgula)
ENCONTROS_ESTADOS_CIVIS=solteiro
ENCONTROS_IDADE_MINIMA=18

# IA: JEV da OpenRouter (sem a chave, a afinidade é só pelos hobbies iguais)
# ENCONTROS_OPENROUTER_API_KEY=   (ou OPENROUTER_API_KEY no .env.test da raiz)
# ENCONTROS_MODELO_JEV=~typesafe/jev-latest
# ENCONTROS_MODELO_RESERVA=deepseek/deepseek-v4.1-flash
